{
  "name": "asciichem",
  "version": "0.1.4",
  "description": "TypeScript implementation of AsciiChem — parse ASCII chemistry into a semantic model and render Text, SVG, and canonical JSON wire form. Conformant with asciichem-model v1 and the asciichem-tests corpus.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asciichem/asciichem-ts.git"
  },
  "homepage": "https://asciichem.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/parg && cp src/parg/asciichem.json dist/parg/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build",
    "bench": "npm run build >/dev/null && node bench/engines.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.17.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "leptris": "^0.1.51",
    "parsanol": "^0.10.48"
  }
}
